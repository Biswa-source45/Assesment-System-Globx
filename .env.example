# ---------------------------------------------------------------
# GLOBX Assess configuration. Copy this file to .env and restart the server after changes.
# ---------------------------------------------------------------

# Web server. Use HOST=0.0.0.0 to allow other PCs on the LAN to connect,
# and set PUBLIC_BASE_URL to the address candidates will use (it goes into invite e-mails).
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# DEMO_MODE=true shows one-time codes on screen while e-mail (SMTP) is not configured.
# Set it to false for real assessments.
DEMO_MODE=true

# REQUIRED. Long random string used to sign sessions (python -c "import secrets;print(secrets.token_urlsafe(48))"). Never share it.
SECRET_KEY=

# Database (PostgreSQL). Falls back to a SQLite file only if unset.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/oap

# E-mail (optional). Without SMTP_HOST all mails are kept in System > Mail outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GLOBX Assess <no-reply@globx.co.in>
SMTP_TLS=true

# Staff security
REQUIRE_ADMIN_MFA=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=12

# Code sandboxes (no Docker). Leave empty to auto-detect from PATH, or give full paths, e.g.
# SANDBOX_GCC=C:\mingw64\bin\gcc.exe
# SANDBOX_GPP=C:\mingw64\bin\g++.exe
# SANDBOX_JAVAC=C:\Program Files\Eclipse Adoptium\jdk-17\bin\javac.exe
# SANDBOX_JAVA=C:\Program Files\Eclipse Adoptium\jdk-17\bin\java.exe
# SANDBOX_NODE=C:\Program Files\nodejs\node.exe
SANDBOX_PYTHON=
SANDBOX_GCC=
SANDBOX_GPP=
SANDBOX_JAVAC=
SANDBOX_JAVA=
SANDBOX_NODE=
# Parallel judge workers (CPU cores - 1 is a good value)
JUDGE_WORKERS=2
# Optional SQL engines for SQL questions (SQLite is always available):
# SQL_POSTGRES_DSN=postgresql://judge:password@localhost:5432/judge
# SQL_MYSQL_DSN=mysql://judge:password@localhost:3306/judge

# AI-assisted evaluation: none | ollama | openai | azure_openai | gemini | claude
LLM_PROVIDER=none
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_AZURE_OPENAI_ENDPOINT=
LLM_AZURE_OPENAI_DEPLOYMENT=
LLM_GEMINI_API_KEY=
LLM_ANTHROPIC_API_KEY=

# Live view: STUN/TURN servers as a JSON list. Leave empty on a normal office network; add a TURN server only if the Wi-Fi blocks laptops from reaching each other.
LIVE_ICE_SERVERS=[]
