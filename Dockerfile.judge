# The isolated judge: the only place candidate code runs in production. It holds the compilers and the sandbox code and nothing else:
# no .env, no database client, no secrets, no camera pictures. See docker-compose.yml for how it is locked down.
FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ libc6-dev default-jdk-headless nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "fastapi==0.115.5" "starlette==0.41.3" "uvicorn==0.32.1" "pydantic>=2.9,<3" "pydantic-settings==2.7.0" psutil "httpx==0.28.1"

WORKDIR /srv
COPY backend/judge_service.py ./
COPY backend/app/__init__.py app/__init__.py
COPY backend/app/core/__init__.py backend/app/core/config.py app/core/
COPY backend/app/domain app/domain
COPY backend/app/sandbox app/sandbox
COPY backend/judge_entrypoint.sh /usr/local/bin/judge-entrypoint
RUN chmod 755 /usr/local/bin/judge-entrypoint && chmod -R a+rX /srv

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["judge-entrypoint"]
