# Copy to `.env` next to docker-compose.yml ON THE SERVER and fill in. Never commit the real file, never paste it in chat.
# Make the passwords long and random, e.g. in PowerShell:  [Convert]::ToBase64String((1..36 | % { Get-Random -Max 256 }) -as [byte[]])

DOMAIN=assessment.globx.co.in
DB_PASSWORD=
SECRET_KEY=

# Cloudflare API token (Zone:Read + DNS:Edit for globx.co.in only). Needed so Caddy can get the certificate.
CLOUDFLARE_API_TOKEN=

# AI marking of text answers (optional): none | openai
LLM_PROVIDER=none
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
