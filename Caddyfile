{
	# Only port 443. Port 80 belongs to another app on this server and the certificate does not need it.
	auto_https disable_redirects
}

{$DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	encode zstd gzip
	# Visitors from the internet arrive through the Cloudflare tunnel, which names the real visitor in Cf-Connecting-Ip (Cloudflare always sets it).
	# Pass that on, so the exam records the candidate's own address and not the tunnel's. Office visitors have no such header and keep the default.
	@viaTunnel header Cf-Connecting-Ip *
	handle @viaTunnel {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {header.Cf-Connecting-Ip}
		}
	}
	handle {
		reverse_proxy api:8000
	}
}
