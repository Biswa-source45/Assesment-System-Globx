# The exam server: the API and the built website in one image (the backend serves frontend/dist itself).
# It runs no candidate code (that is the judge's job) and holds no compilers.
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json frontend/copy-mediapipe.js ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
RUN useradd --uid 1000 --create-home app
WORKDIR /srv/backend
COPY backend/requirements.txt ./
RUN grep -v pytest requirements.txt | pip install --no-cache-dir -r /dev/stdin
COPY backend/alembic.ini ./
COPY backend/migrations migrations
COPY backend/app app
COPY --from=web /web/dist /srv/frontend/dist
RUN mkdir data && chown app data   # where `python -m app.seed` writes the first accounts' passwords
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER app
# Behind Caddy only (no published port), so the forwarded client address can be trusted.
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
