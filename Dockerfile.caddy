# Caddy with the Cloudflare DNS plugin: the HTTPS certificate is proven through the domain's DNS (managed at Cloudflare), because the server
# has a private office address that Let's Encrypt cannot reach.
FROM caddy:2-builder AS build
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2
COPY --from=build /usr/bin/caddy /usr/bin/caddy
# the settings are part of the image: the server needs no Caddyfile of its own
COPY Caddyfile /etc/caddy/Caddyfile
